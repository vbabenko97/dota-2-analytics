# Data — raw snapshots are immutable but large; track manifests, not payloads
data/raw/
data/interim/
data/processed/
!data/**/manifest.json

# Secrets — STRATZ / OpenDota keys, market API credentials
.env
*.key
config/secrets.yaml

# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/
*.egg-info/

# CLI output — generated, not tracked
reports/

# Agent harness local state — machine-local config, plugin caches, and skill
# scratch workspaces. None of it is project source.
.superpowers/
.claude/
.claude-plugin/
.codex/

# macOS
.DS_Store
